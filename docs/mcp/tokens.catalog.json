  "rules": [
    "Use semantic tokens for app-level theme overrides.",
    "Use component tokens for local component tuning.",
    "Do not write raw hex colors in generated components.",
    "Do not create new --wa-* tokens without extending the design system source.",
    "Use app-specific custom properties outside the --wa- namespace when a project needs private values."
  ]
