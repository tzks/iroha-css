  "component": [
    "--wa-card-bg",
    "--wa-card-color",
    "--wa-card-border",
    "--wa-card-radius",
    "--wa-card-shadow",
    "--wa-card-padding",
    "--wa-card-accent",
    "--wa-button-bg",
    "--wa-button-color",
    "--wa-button-border",
    "--wa-button-radius",
    "--wa-button-padding-x",
    "--wa-button-padding-y",
    "--wa-input-bg",
    "--wa-input-color",
