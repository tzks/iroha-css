      "wa-button",
      "wa-button--secondary",
      "wa-button--accent",
      "wa-button--ghost",
      "wa-button--soft",
      "wa-button--outline",
      "wa-button--danger",
      "wa-button--sm",
      "wa-button--lg",
      "wa-button--block",
      "wa-button--seal"
    ],
    "card": [
      "wa-card",
      "wa-card--quiet",
