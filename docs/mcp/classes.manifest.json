{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "iroha-css class manifest",
  "classPrefix": "wa-",
  "themeAttribute": "data-wa-theme",
  "densityAttribute": "data-wa-density",
  "contrastAttribute": "data-wa-contrast",
  "themes": ["sakura", "sumi", "ai", "matcha", "kurenai", "yamabuki"],
  "layout": [
    "wa-container",
    "wa-section",
    "wa-section--muted",
    "wa-stack",
    "wa-flow",
    "wa-cluster",
    "wa-grid",
    "wa-split",
    "wa-sidebar",
    "wa-switcher",
    "wa-reel",
    "wa-frame",
    "wa-bleed",
    "wa-layer",
    "wa-offset",
    "wa-masonry",
    "wa-cover",
    "wa-ma",
    "wa-editorial",
    "wa-story",
    "wa-silent",
    "wa-journal",
    "wa-product"
  ],
  "components": {
    "button": [
      "wa-button",
      "wa-button--secondary",
      "wa-button--accent",
      "wa-button--ghost",
      "wa-button--soft",
      "wa-button--outline",
      "wa-button--danger",
      "wa-button--sm",
      "wa-button--lg",
      "wa-button--block",
      "wa-button--seal"
    ],
    "card": [
      "wa-card",
      "wa-card--quiet",
      "wa-card--bordered",
      "wa-card--elevated",
      "wa-card--accent",
      "wa-card--danger",
      "wa-card--washi"
    ],
    "form": [
      "wa-form",
      "wa-field",
      "wa-field--invalid",
      "wa-field__hint",
      "wa-input",
      "wa-select",
      "wa-textarea",
      "wa-error"
    ],
    "navigation": [
      "wa-nav",
      "wa-breadcrumb",
      "wa-pagination",
      "wa-page",
      "wa-dropdown",
      "wa-dropdown__menu",
      "wa-dropdown__item"
    ],
    "feedback": [
      "wa-alert",
      "wa-alert--danger",
      "wa-alert--success",
      "wa-alert--accent",
      "wa-alert--subtle",
      "wa-toast",
      "wa-toast--success",
      "wa-toast--danger",
      "wa-empty",
      "wa-empty__mark",
      "wa-skeleton"
    ],
    "data": [
      "wa-table-wrap",
      "wa-table",
      "wa-table--striped",
      "wa-table--compact",
      "wa-stat",
      "wa-stat__value",
      "wa-stat__label",
      "wa-donut",
      "wa-donut__value",
      "wa-donut--accent",
      "wa-donut--danger",
      "wa-donut--sm",
      "wa-progress",
      "wa-progress__bar",
      "wa-progress--accent",
      "wa-progress--danger",
      "wa-progress--lg",
      "wa-bar-chart",
      "wa-bar-chart__bar",
      "wa-meter",
      "wa-meter__track",
      "wa-meter__marker"
    ],
    "content": [
      "wa-hero",
      "wa-hero__kicker",
      "wa-hero__title",
      "wa-article",
      "wa-footer",
      "wa-badge",
      "wa-badge--primary",
      "wa-badge--danger",
      "wa-badge--solid",
      "wa-chip",
      "wa-chip--primary",
      "wa-chip--accent",
      "wa-chip--danger",
      "wa-callout",
      "wa-callout--accent",
      "wa-quote",
      "wa-media",
      "wa-media__figure",
      "wa-media__body",
      "wa-divider",
      "wa-divider--accent",
      "wa-list",
      "wa-list__item",
      "wa-avatar",
      "wa-avatar--sm",
      "wa-avatar--lg",
      "wa-avatar-group"
    ],
    "interactiveSurfaces": [
      "wa-tabs",
      "wa-tabs__list",
      "wa-tabs__tab",
      "wa-tabs__panel",
      "wa-modal",
      "wa-modal-backdrop",
      "wa-accordion",
      "wa-accordion__item",
      "wa-accordion__content",
      "wa-stepper",
      "wa-stepper__item"
    ],
    "japanese": ["wa-washi", "wa-kasane", "wa-seal", "wa-kamon", "wa-vertical"]
  },
  "utilities": [
    "wa-visually-hidden",
    "wa-center",
    "wa-mt-4",
    "wa-mb-4",
    "wa-p-4",
    "wa-p-6",
    "wa-px-4",
    "wa-py-4",
    "wa-space-6",
    "wa-gap-2",
    "wa-gap-4",
    "wa-gap-6",
    "wa-text-muted",
    "wa-text-balance",
    "wa-text-serif",
    "wa-text-sm",
    "wa-text-lg",
    "wa-leading-relaxed",
    "wa-hidden",
    "wa-block",
    "wa-inline",
    "wa-inline-flex",
    "wa-full-width",
    "wa-bg",
    "wa-surface",
    "wa-surface-muted",
    "wa-border",
    "wa-text-primary",
    "wa-text-accent",
    "wa-rule-start",
    "wa-hide-sm",
    "wa-stack-sm",
    "wa-hide-md"
  ],
  "rules": [
    "Do not invent wa-* classes.",
    "Use documented classes from this manifest.",
    "Use app-specific class names outside the wa- namespace for custom behavior.",
    "Use CSS variables for values, not raw colors."
  ]
}
