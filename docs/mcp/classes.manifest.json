      "wa-tabs__tab",
      "wa-tabs__panel",
      "wa-modal",
      "wa-modal-backdrop",
      "wa-accordion",
      "wa-accordion__item",
      "wa-accordion__content",
      "wa-stepper",
      "wa-stepper__item",
      "wa-drawer",
      "wa-drawer--end",
      "wa-popover",
      "wa-tooltip",
      "wa-context-menu",
      "wa-sheet"
    ],
    "japanese": [
      "wa-washi",
      "wa-kasane",
      "wa-seal",
      "wa-kamon",
      "wa-vertical",
      "wa-noren",
      "wa-tanzaku",
      "wa-shoji",
      "wa-ink-line",
      "wa-season-mark",
      "wa-label-seal"
    ],
