    "wa-center",
    "wa-mt-4",
    "wa-mb-4",
    "wa-p-4",
    "wa-p-6",
    "wa-px-4",
    "wa-py-4",
    "wa-space-6",
    "wa-gap-2",
    "wa-gap-4",
    "wa-gap-6",
    "wa-text-muted",
    "wa-text-balance",
    "wa-text-serif",
    "wa-text-sm",
    "wa-text-lg",
    "wa-leading-relaxed",
    "wa-hidden",
    "wa-block",
    "wa-inline",
    "wa-inline-flex",
    "wa-full-width",
    "wa-bg",
