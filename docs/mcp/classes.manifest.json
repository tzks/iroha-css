      "wa-table",
      "wa-table--striped",
      "wa-table--compact",
      "wa-stat",
      "wa-stat__value",
      "wa-stat__label",
      "wa-donut",
      "wa-donut__value",
      "wa-donut--accent",
      "wa-donut--danger",
      "wa-donut--sm",
