{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "iroha-css class manifest",
  "classPrefix": "wa-",
  "themeAttribute": "data-wa-theme",
  "densityAttribute": "data-wa-density",
  "contrastAttribute": "data-wa-contrast",
  "themes": ["sakura", "sumi", "ai", "matcha", "kurenai", "yamabuki"],
  "layout": [
    "wa-container",
    "wa-section",
    "wa-section--muted",
    "wa-stack",
    "wa-flow",
    "wa-cluster",
    "wa-grid",
    "wa-split",
    "wa-sidebar",
    "wa-switcher",
    "wa-reel",
    "wa-frame",
    "wa-bleed",
    "wa-layer",
    "wa-offset",
    "wa-masonry",
    "wa-cover",
    "wa-ma",
    "wa-editorial",
    "wa-story",
    "wa-silent",
    "wa-journal",
    "wa-product"
  ],
  "components": {
