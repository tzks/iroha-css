      "wa-command__list",
      "wa-command__item",
      "wa-filter-bar",
      "wa-segmented-control",
      "wa-tag-input"
    ],
    "patterns": [
      "wa-toolbar",
      "wa-action-bar",
      "wa-detail-panel",
      "wa-master-detail",
      "wa-settings-section"
